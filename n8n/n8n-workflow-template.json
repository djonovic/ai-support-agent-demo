{
  "name": "TEMPLATE - AI support + lead qualification + booking (BrightSmile demo, fictional)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dental-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook (chat message)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "dental-lead-demo"
    },
    {
      "parameters": {
        "jsCode": "// TEMPLATE: simple keyword retrieval over the clinic knowledge base.\n// In production replace with a vector store (Supabase pgvector / Pinecone) + embeddings.\nconst KB = [\n  {id:'KB-01', title:'Opening hours', text:'Open Mon-Fri 08:00-19:00, Sat 09:00-14:00, closed Sundays.'},\n  {id:'KB-04', title:'Teeth whitening', text:'In-clinic whitening €290 (90 min); take-home kit €190.'},\n  {id:'KB-05', title:'Dental implants', text:'Single implant incl. crown from €1,200; 3-6 months; free consultation.'},\n  {id:'KB-08', title:'Cancellation policy', text:'Free cancellation up to 24h before; late cancellation/no-show €25.'},\n  {id:'KB-09', title:'Payment & instalments', text:'Cash/cards; treatments over €500 in 3/6/12 interest-free instalments.'}\n];\nconst q = ($json.body?.message || '').toLowerCase();\nconst terms = q.split(/[^a-z0-9€]+/).filter(t => t.length > 2);\nconst scored = KB.map(d => ({...d, score: terms.filter(t => (d.title + ' ' + d.text).toLowerCase().includes(t)).length}))\n  .sort((a, b) => b.score - a.score).slice(0, 3).filter(d => d.score > 0);\nreturn [{ json: { ...$json.body, sources: scored, context: scored.map(d => `[${d.id}] ${d.title}: ${d.text}`).join('\\n') } }];"
      },
      "id": "n2",
      "name": "Retrieve KB passages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "You are the support assistant of BrightSmile Dental Studio (FICTIONAL demo clinic). Answer ONLY from the context passages and cite their IDs like [KB-04]. If the answer is not in the context, say you don't know. Also extract lead fields from the conversation. Reply as JSON: {\"answer\": string, \"cited\": [ids], \"lead\": {\"name\",\"email\",\"need\",\"budget\",\"timeline\"}}.",
              "role": "system"
            },
            {
              "content": "=Context:\n{{ $json.context }}\n\nKnown lead so far: {{ JSON.stringify($json.lead || {}) }}\n\nUser message: {{ $json.message }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "n3",
      "name": "LLM: grounded answer + lead extraction",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        440,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAI account (add your own)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// TEMPLATE: parse the LLM's JSON output into answer + lead fields.\nconst raw = $json.message?.content ?? $json.text ?? $json.output ?? '{}';\nlet out; try { out = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { out = { answer: String(raw), lead: {} }; }\nconst prev = $('Retrieve KB passages').first().json;\nconst lead = { session_id: prev.session_id || null, ...(prev.lead || {}), ...(out.lead || {}) };\nconst qualified = !!(lead.name && lead.need && lead.budget && lead.timeline);\nreturn [{ json: { answer: out.answer, cited: out.cited || prev.sources.map(s => s.id), lead, qualified, booking_slot: prev.booking_slot || null } }];"
      },
      "id": "n4",
      "name": "Parse answer + lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.qualified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n5",
      "name": "Lead qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
