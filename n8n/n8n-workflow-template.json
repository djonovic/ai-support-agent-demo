          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "name": "={{ $json.lead.name }}",
            "email": "={{ $json.lead.email }}",
            "need": "={{ $json.lead.need }}",
            "budget": "={{ $json.lead.budget }}",
            "timeline": "={{ $json.lead.timeline }}",
            "source": "website-chat"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "n6",
